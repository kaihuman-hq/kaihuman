{
  "name": "@lifosy/app-console",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-version.js && vite",
    "prod": "node scripts/generate-version.js && vite --mode prod",
    "build": "node scripts/generate-version.js && vite build",
    "build:prod": "node scripts/bump-version.js && vite build --mode prod",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.js",
    "version:bump:minor": "node scripts/bump-version.js minor",
    "version:bump:major": "node scripts/bump-version.js major",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.11",
    "@lifosy/core": "workspace:*",
    "@lifosy/ui": "workspace:*",
    "@preact/signals": "^2.0.1",
    "lucide-preact": "^0.562.0",
    "preact": "^10.25.4",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@lifosy/config": "workspace:*",
    "@preact/preset-vite": "^2.9.3",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/coverage-v8": "^4.1.4",
    "tailwindcss": "^4.1.18",
    "typescript": "5.9.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
