.{
    // App identity
    .id = "com.lifosy.kh-capture",
    .name = "kh-capture",
    .display_name = "KH Capture",
    .version = "0.1.0",

    // A single small capture window. always-on-top / float / center are handled
    // by Hyprland window rules (see README) rather than declared here, so this
    // stays portable across compositors.
    .windows = .{
        .{
            .label = "main",
            .title = "KH Capture",
            .width = 560,
            .height = 160,
            .resizable = true,
            .restore_state = false,
        },
    },

    // This build performs HTTP (fetch) and file I/O (readFile/writeFile), and
    // closes its own window. VERIFY(api): the docs don't publish the exact
    // permission strings for network/filesystem effects — reconcile against a
    // freshly scaffolded app (`native init --template zig-core`). "net"/"fs" are
    // placeholders; the effects may need no manifest permission at all.
    .permissions = .{ "view", "window", "net", "fs" },
    .capabilities = .{ "shortcuts" },
}
