{
  "name": "@kaihuman/kb-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing a local kaihuman .kh knowledge base to LLM agents",
  "type": "module",
  "bin": {
    "kaihuman-kb-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fix": "biome check --write --unsafe .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kaihuman/formats": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
