{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kaihuman-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.kaihuman.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaihuman-share",
      "database_id": "<set after wrangler d1 create>",
      "migrations_dir": "migrations"
    }
  ],
  // Stores only ciphertext; the keys stay in the link fragment and never reach the worker.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "kaihuman-share", "jurisdiction": "eu" }],
  "vars": {
    "CONSOLE_ORIGINS": "https://app.kaihuman.com",
    "QUOTA_BYTES": "524288000",
    "MAX_BYTES": "10485760",
    "UPLOADS_PER_HOUR": "30",
    "ABUSE_EMAIL": "abuse@kaihuman.com"
  },
  // As in auth-worker: without host and upstream_protocol, `wrangler dev` rewrites request
  // URLs to https://docs.kaihuman.com, so any absolute URL built from request.url would
  // point at production instead of localhost.
  "dev": { "port": 8788, "host": "localhost:8788", "upstream_protocol": "http" }
}
