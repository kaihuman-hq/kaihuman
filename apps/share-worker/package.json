{
  "name": "@kaihuman/share-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that stores encrypted business documents for share links; it never sees the keys",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fix": "biome check --write --unsafe .",
    "test": "vitest run"
  },
  "dependencies": {
    "@kaihuman/formats": "workspace:*"
  }
}
