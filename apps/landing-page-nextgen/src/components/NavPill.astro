---
interface Props {
  /** Marks the Docs link as the current page. */
  current?: 'docs';
}

const { current } = Astro.props;
---

<!-- ── Nav · N5 Floating Pill ────────────────────────── -->
<nav class="nav-pill" aria-label="Site navigation">
  <a href="/" class="nav-pill__wordmark" aria-label="kaihuman home">kaihuman</a>
  <span class="nav-pill__sep" aria-hidden="true"></span>
  <a href="/docs/" class="nav-pill__link" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
  <a href="/docs/cli-quickstart/" class="nav-pill__link">CLI</a>
  <a href="https://app.kaihuman.com" class="nav-pill__action">Open App</a>
</nav>

<style>
  /* ── NAV · N5 Floating Pill ───────────────────────────── */

  .nav-pill {
    position: fixed;
    top: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: oklch(10% 0.008 145 / 0.85);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    white-space: nowrap;
  }

  .nav-pill__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-pill__wordmark:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .nav-pill__sep {
    width: 1px;
    height: 1rem;
    background: var(--color-rule);
  }

  .nav-pill__link {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-pill__link:hover {
      color: var(--color-accent);
    }
  }

  .nav-pill__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .nav-pill__action {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    white-space: nowrap;
    transition:
      border-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-pill__action:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .nav-pill__action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .nav-pill__link[aria-current='page'] {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .nav-pill {
      top: var(--space-md);
      padding: var(--space-2xs) var(--space-sm);
    }
  }
</style>
