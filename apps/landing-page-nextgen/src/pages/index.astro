---
import Layout from '../layouts/Layout.astro';
---

<Layout title="kaihuman — The ever-improving human.">

  <!-- ── Nav · N6 Newspaper Masthead ─────────────────── -->
  <nav class="masthead" aria-label="Site navigation">
    <div class="masthead__rule"></div>
    <div class="masthead__body">
      <span class="masthead__edition">Vol. 1 · 改</span>
      <a href="/" class="masthead__wordmark" aria-label="kaihuman home">kaihuman</a>
      <a href="https://app.kaihuman.com" class="masthead__action">Open App</a>
    </div>
    <p class="masthead__tag">改 · The practice of continuous improvement · Open Source &amp; Independent</p>
    <div class="masthead__rule masthead__rule--double"></div>
  </nav>

  <main>

    <!-- ── Hero · Manifesto Declaration ───────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__inner">
        <div class="reveal">
          <h1 class="hero__declaration" id="hero-heading">
            EVERY DAY<br>IS AN <em class="block-accent">EDIT</em>.
          </h1>
        </div>
        <p class="hero__sub reveal" style="--i: 1">
          改 &nbsp;·&nbsp; kai &nbsp;·&nbsp; the practice of continuous improvement
        </p>
      </div>
    </section>

    <!-- ── Philosophy ──────────────────────────────────── -->
    <section class="philosophy" aria-label="Philosophy">
      <div class="philosophy__inner">
        <p class="claim reveal">
          Kaizen — the Japanese discipline of getting 1% better, every single day — is the most powerful force in human development.
        </p>
        <p class="claim claim--em reveal" style="--i: 1">
          Not a hack. Not a system. A philosophy.
        </p>
        <p class="claim reveal" style="--i: 2">
          kaihuman is the tool that makes it real.
        </p>
      </div>
    </section>

    <!-- ── Principles ─────────────────────────────────── -->
    <section class="principles" aria-label="Core principles">
      <div class="principles__inner">

        <div class="principle reveal">
          <h2 class="principle__heading">Track</h2>
          <p class="principle__sub">Everything, organized.</p>
          <p class="principle__desc">
            Todos, habits, time, budgets, knowledge — every dimension of your life in one place.
            Visible. Measurable. Yours to reflect on.
          </p>
        </div>

        <div class="principle reveal" style="--i: 1">
          <h2 class="principle__heading">Own</h2>
          <p class="principle__sub">Plain files. No lock-in.</p>
          <p class="principle__desc">
            Your data lives on GitHub in plain text files. Readable by any editor. Portable forever.
            We store nothing on our servers. Your growth is not our product.
          </p>
        </div>

        <div class="principle reveal" style="--i: 2">
          <h2 class="principle__heading">Know</h2>
          <p class="principle__sub">An AI that reads you.</p>
          <p class="principle__desc">
            A companion that reads your files and understands your context. It knows your goals,
            your habits, your history. Not a chatbot — a collaborator in your growth.
          </p>
        </div>

      </div>
    </section>

    <!-- ── Data Ownership ─────────────────────────────── -->
    <section class="ownership" aria-label="Data ownership">
      <div class="ownership__inner">
        <div class="reveal">
          <h2 class="ownership__headline">
            YOUR DATA.<br>YOUR RULES.
          </h2>
        </div>
        <p class="ownership__body reveal" style="--i: 1">
          kaihuman is built Local-First. We store nothing. Your plain files outlast any software,
          any company, any platform. We do not surveil you. Your growth is not a product to be sold.
        </p>
      </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────── -->
    <section class="cta-section" aria-label="Call to action">
      <div class="cta-section__inner reveal">
        <p class="cta-section__prompt">One deliberate day at a time.</p>
        <a href="https://app.kaihuman.com" class="cta-section__btn">
          START IMPROVING TODAY
        </a>
        <a href="https://github.com/lifosy/monorepo" class="cta-section__secondary">
          View source on GitHub →
        </a>
      </div>
    </section>

  </main>

  <!-- ── Footer · Ft1 Mast-headed ──────────────────────── -->
  <footer class="footer">
    <div class="footer__rule"></div>
    <div class="footer__inner">
      <a href="/" class="footer__wordmark" aria-label="kaihuman home">kaihuman</a>
      <span class="footer__tagline">改 · The ever-improving human</span>
      <span class="footer__meta">Open Source &amp; Independent &nbsp;·&nbsp; © {new Date().getFullYear()}</span>
    </div>
    <div class="footer__rule"></div>
  </footer>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.08 }
  );

  document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  /* ── MASTHEAD NAV ──────────────────────────────────── */

  .masthead {
    background: var(--color-paper);
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
    padding-block: 0 var(--space-xs);
  }

  .masthead__rule {
    height: 1px;
    background: var(--color-ink);
    margin-block: var(--space-xs);
  }

  .masthead__rule--double {
    position: relative;
    margin-top: var(--space-xs);
  }

  .masthead__rule--double::after {
    content: '';
    position: absolute;
    inset: 3px 0 auto;
    height: 1px;
    background: var(--color-ink);
  }

  .masthead__body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
  }

  .masthead__edition {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .masthead__wordmark {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3vw + 0.5rem, var(--text-3xl));
    font-style: italic;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .masthead__wordmark:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .masthead__action {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-decoration: none;
    border: 1.5px solid var(--color-accent);
    padding: var(--space-2xs) var(--space-sm);
    white-space: nowrap;
    transition:
      background var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  .masthead__action:hover {
    background: var(--color-accent);
    color: var(--color-paper);
  }

  .masthead__action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .masthead__tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-align: center;
    padding-bottom: var(--space-sm);
  }

  /* ── HERO ─────────────────────────────────────────── */

  .hero {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: clamp(var(--space-3xl), 12vw, var(--space-4xl)) var(--space-3xl);
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
  }

  .hero__inner {
    max-width: 88rem;
    margin-inline: auto;
  }

  .hero__declaration {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.03;
    color: var(--color-paper);
    transform: rotate(-2deg);
    transform-origin: left top;
    display: inline-block;
    margin-bottom: var(--space-2xl);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .block-accent {
    font-style: normal;
    background: var(--color-accent);
    color: var(--color-paper);
    padding: 0.04em 0.18em 0.08em;
    display: inline-block;
    line-height: 1;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neutral);
  }

  /* ── PHILOSOPHY ───────────────────────────────────── */

  .philosophy {
    background: var(--color-paper);
    padding-block: clamp(var(--space-2xl), 8vw, var(--space-3xl));
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
    border-top: 1px solid var(--color-rule);
  }

  .philosophy__inner {
    max-width: 62ch;
  }

  .claim {
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 2.5vw + 0.5rem, var(--text-xl));
    color: var(--color-ink);
    line-height: 1.45;
    margin-bottom: var(--space-xl);
  }

  .claim--em {
    font-style: italic;
    color: var(--color-accent);
  }

  .claim:last-child {
    margin-bottom: 0;
  }

  /* ── PRINCIPLES ───────────────────────────────────── */

  .principles {
    background: var(--color-paper-2);
    padding-block: 0 clamp(var(--space-2xl), 8vw, var(--space-3xl));
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
  }

  .principles__inner {
    max-width: 88rem;
    margin-inline: auto;
  }

  .principle {
    padding-block: clamp(var(--space-xl), 5vw, var(--space-2xl));
    border-top: 1px solid var(--color-rule);
  }

  .principle:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .principle__heading {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 7vw + 0.5rem, 5.5rem);
    font-style: italic;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-sm);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .principle__sub {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .principle__desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 52ch;
  }

  /* ── DATA OWNERSHIP ───────────────────────────────── */

  .ownership {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: clamp(var(--space-2xl), 10vw, var(--space-4xl));
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
  }

  .ownership__inner {
    max-width: 50ch;
  }

  .ownership__headline {
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-paper);
    margin-bottom: var(--space-xl);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .ownership__body {
    font-family: var(--font-body);
    font-size: clamp(var(--text-base), 1.5vw + 0.5rem, var(--text-lg));
    color: var(--color-neutral);
    line-height: 1.65;
  }

  /* ── CTA SECTION ──────────────────────────────────── */

  .cta-section {
    background: var(--color-paper);
    padding-block: clamp(var(--space-3xl), 12vw, var(--space-4xl));
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
    border-top: 1px solid var(--color-rule);
  }

  .cta-section__inner {
    max-width: 88rem;
    margin-inline: auto;
  }

  .cta-section__prompt {
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 2.5vw + 0.5rem, var(--text-xl));
    font-style: italic;
    color: var(--color-muted);
    margin-bottom: var(--space-2xl);
  }

  .cta-section__btn {
    display: block;
    width: fit-content;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: var(--space-lg) var(--space-2xl);
    margin-bottom: var(--space-lg);
    white-space: nowrap;
    transition:
      background var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-section__btn:hover {
      background: var(--color-accent);
      color: var(--color-paper);
    }
  }

  .cta-section__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .cta-section__secondary {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.06em;
    width: fit-content;
    transition: color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-section__secondary:hover {
      color: var(--color-ink);
      text-decoration: underline;
    }
  }

  .cta-section__secondary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ── FOOTER · Ft1 ─────────────────────────────────── */

  .footer {
    background: var(--color-paper-2);
    padding-inline: clamp(var(--space-lg), 5vw, var(--space-2xl));
    padding-block: var(--space-sm);
  }

  .footer__rule {
    height: 1px;
    background: var(--color-rule);
    margin-block: var(--space-sm);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-md);
    flex-wrap: wrap;
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .footer__wordmark:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer__meta {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-left: auto;
    white-space: nowrap;
  }

  /* ── REVEAL ANIMATION ─────────────────────────────── */

  .reveal {
    opacity: 0;
    transform: translateX(-18px);
    transition:
      opacity  var(--dur-long) var(--ease-out),
      transform var(--dur-long) var(--ease-out);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      transform: none;
      transition: opacity 150ms linear;
      transition-delay: 0ms;
    }
  }

  /* ── RESPONSIVE ───────────────────────────────────── */

  @media (max-width: 40rem) {
    .masthead__body {
      flex-wrap: wrap;
      align-items: center;
    }

    .masthead__edition {
      order: 3;
      flex-basis: 100%;
      text-align: center;
    }

    .hero__declaration {
      transform: none;
    }

    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .footer__meta {
      margin-left: 0;
    }
  }

  @media (min-width: 60rem) {
    .principle__desc {
      max-width: 60ch;
    }
  }
</style>
