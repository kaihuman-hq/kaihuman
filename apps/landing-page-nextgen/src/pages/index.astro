---
import Layout from '../layouts/Layout.astro';
---

<Layout title="kaihuman — The ever-improving human.">

  <!-- ── Nav · N5 Floating Pill ────────────────────────── -->
  <nav class="nav-pill" aria-label="Site navigation">
    <a href="/" class="nav-pill__wordmark" aria-label="kaihuman home">kaihuman</a>
    <span class="nav-pill__sep" aria-hidden="true"></span>
    <a href="https://app.kaihuman.com" class="nav-pill__action">Open App</a>
  </nav>

  <main>

    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
      <!-- Atmospheric radial bloom -->
      <div class="hero__bloom" aria-hidden="true"></div>
      <!-- Cyber grid -->
      <div class="hero__grid" aria-hidden="true"></div>
      <!-- Ghost kanji -->
      <div class="hero__kanji" aria-hidden="true">改</div>

      <div class="hero__inner">
        <!-- Status indicator -->
        <div class="hero__status reveal">
          <span class="hero__status-dot" aria-hidden="true"></span>
          <span>KAIZEN ACTIVE</span>
        </div>

        <div class="reveal" style="--i: 1">
          <h1 class="hero__declaration" id="hero-heading">
            EVERY DAY<br>IS AN <em class="block-accent">EDIT</em>.
          </h1>
        </div>

        <p class="hero__sub reveal" style="--i: 2">
          改 &nbsp;·&nbsp; kai &nbsp;·&nbsp; continuous improvement &nbsp;·&nbsp; one percent, every day
        </p>

        <div class="hero__ctas reveal" style="--i: 3">
          <a href="https://app.kaihuman.com" class="btn-primary">Start Improving</a>
          <a href="https://github.com/lifosy/monorepo" class="btn-ghost">View Source →</a>
        </div>
      </div>
    </section>

    <!-- ── Philosophy ─────────────────────────────────────── -->
    <section class="philosophy" aria-label="Philosophy">
      <div class="section-inner">
        <p class="philosophy__claim reveal">
          Kaizen — the discipline of getting 1% better, every single day — is the most powerful
          force in human development.
        </p>
        <p class="philosophy__accent reveal" style="--i: 1">
          // not a hack. not a system. a practice.
        </p>
        <p class="philosophy__body reveal" style="--i: 2">
          Most productivity tools optimize for doing more. kaihuman is built to help you become better.
          There is a difference. The difference compounds.
        </p>
      </div>
    </section>

    <!-- ── Principles ──────────────────────────────────────── -->
    <section class="principles" aria-label="Core principles">
      <div class="section-inner">

        <div class="principle reveal">
          <h2 class="principle__heading">Track</h2>
          <p class="principle__label">// everything, organized</p>
          <p class="principle__desc">
            Todos, habits, time, budgets, knowledge — every dimension of your life in one place.
            Visible. Measurable. Yours to reflect on.
          </p>
        </div>

        <div class="principle reveal" style="--i: 1">
          <h2 class="principle__heading">Own</h2>
          <p class="principle__label">// plain files. zero lock-in.</p>
          <p class="principle__desc">
            Your data lives on GitHub in plain text files. Readable by any editor. Portable forever.
            We store nothing. Your growth is not our product.
          </p>
        </div>

        <div class="principle reveal" style="--i: 2">
          <h2 class="principle__heading">Know</h2>
          <p class="principle__label">// an AI that reads you</p>
          <p class="principle__desc">
            A companion that reads your files and understands your context. Your goals, your habits,
            your history. Not a chatbot — a collaborator in your growth.
          </p>
        </div>

      </div>
    </section>

    <!-- ── Data Ownership ──────────────────────────────────── -->
    <section class="ownership" aria-label="Data ownership">
      <div class="section-inner">
        <div class="ownership__accent-line" aria-hidden="true"></div>
        <div class="reveal">
          <h2 class="ownership__headline">
            YOUR DATA.<br>YOUR RULES.
          </h2>
        </div>
        <p class="ownership__body reveal" style="--i: 1">
          kaihuman is built Local-First. We store nothing. Your plain files outlast any software,
          any company, any platform. We do not surveil you.
          Your growth is not a product to be sold.
        </p>
        <p class="ownership__tagline reveal" style="--i: 2">
          // open source &amp; independent
        </p>
      </div>
    </section>

    <!-- ── CTA ─────────────────────────────────────────────── -->
    <section class="cta-section" aria-label="Call to action">
      <div class="section-inner">
        <div class="cta-section__bloom" aria-hidden="true"></div>
        <p class="cta-section__prompt reveal">
          One deliberate day at a time.
        </p>
        <div class="reveal" style="--i: 1">
          <a href="https://app.kaihuman.com" class="cta-section__btn">
            START IMPROVING TODAY
          </a>
        </div>
        <a href="https://github.com/lifosy/monorepo" class="cta-section__secondary reveal" style="--i: 2">
          github.com/lifosy/monorepo →
        </a>
      </div>
    </section>

  </main>

  <!-- ── Footer · Ft5 Statement ────────────────────────────── -->
  <footer class="footer">
    <div class="footer__inner">
      <span class="footer__statement">
        The instrument is yours. The data is yours. The growth is yours.
      </span>
      <div class="footer__meta">
        <a href="/" class="footer__wordmark" aria-label="kaihuman home">kaihuman</a>
        <span class="footer__copy">© {new Date().getFullYear()}</span>
      </div>
    </div>
  </footer>

</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.06 }
  );

  document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  /* Hallmark · genre: atmospheric · macrostructure: Manifesto · theme: Terminal · enrichment: none · nav: N5 · footer: Ft5 */

  /* ── SHARED ───────────────────────────────────────────── */

  .section-inner {
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: clamp(var(--space-lg), 6vw, var(--space-3xl));
    position: relative;
  }

  /* ── NAV · N5 Floating Pill ───────────────────────────── */

  .nav-pill {
    position: fixed;
    top: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: oklch(10% 0.008 145 / 0.85);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: var(--space-xs) var(--space-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    white-space: nowrap;
  }

  .nav-pill__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-pill__wordmark:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .nav-pill__sep {
    width: 1px;
    height: 1rem;
    background: var(--color-rule);
  }

  .nav-pill__action {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    white-space: nowrap;
    transition:
      border-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-pill__action:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .nav-pill__action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 999px;
  }

  /* ── HERO ─────────────────────────────────────────────── */

  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: var(--color-paper);
    overflow: hidden;
    padding-block: clamp(var(--space-3xl), 12vw, var(--space-4xl));
  }

  /* Atmospheric radial bloom — neon green */
  .hero__bloom {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 900px;
    height: 900px;
    background: radial-gradient(
      circle,
      oklch(87% 0.295 142 / 0.06) 0%,
      oklch(40% 0.120 142 / 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: var(--z-base);
  }

  /* Cyber grid */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(oklch(87% 0.295 142 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, oklch(87% 0.295 142 / 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: var(--z-base);
  }

  /* Ghost kanji */
  .hero__kanji {
    position: absolute;
    top: 50%;
    right: -2vw;
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: clamp(14rem, 30vw, 28rem);
    font-weight: 900;
    color: oklch(87% 0.295 142 / 0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: var(--z-base);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-raised);
    width: 100%;
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: clamp(var(--space-lg), 6vw, var(--space-3xl));
  }

  /* Status indicator */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: var(--space-xl);
    border: 1px solid oklch(87% 0.295 142 / 0.25);
    border-radius: 999px;
    padding: var(--space-2xs) var(--space-sm);
    width: fit-content;
  }

  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
    animation: pulse 2s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__status-dot { animation: none; }
  }

  .hero__declaration {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-ink);
    transform: rotate(-2deg);
    transform-origin: left top;
    display: inline-block;
    margin-bottom: var(--space-2xl);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .block-accent {
    font-style: normal;
    background: var(--color-accent);
    color: var(--color-paper);
    padding: 0.04em 0.2em 0.08em;
    display: inline-block;
    line-height: 1;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neutral);
    margin-bottom: var(--space-2xl);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
  }

  .btn-primary {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-paper);
    padding: var(--space-sm) var(--space-xl);
    border-radius: 2px;
    white-space: nowrap;
    box-shadow: 0 0 24px oklch(87% 0.295 142 / 0.20);
    transition:
      box-shadow var(--dur-short) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      box-shadow: 0 0 36px oklch(87% 0.295 142 / 0.35);
      transform: translateY(-1px);
    }
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .btn-ghost {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-neutral);
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-ghost:hover { color: var(--color-ink); }
  }

  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ── PHILOSOPHY ───────────────────────────────────────── */

  .philosophy {
    background: var(--color-paper-2);
    padding-block: clamp(var(--space-2xl), 10vw, var(--space-4xl));
  }

  .philosophy__claim {
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 2.5vw + 0.5rem, var(--text-xl));
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.4;
    max-width: 55ch;
    margin-bottom: var(--space-xl);
    letter-spacing: -0.015em;
  }

  .philosophy__accent {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-xl);
  }

  .philosophy__body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-neutral);
    line-height: 1.7;
    max-width: 58ch;
  }

  /* ── PRINCIPLES ───────────────────────────────────────── */

  .principles {
    background: var(--color-paper);
    padding-block: clamp(var(--space-2xl), 10vw, var(--space-4xl));
  }

  .principle {
    padding-block: clamp(var(--space-xl), 5vw, var(--space-2xl));
    border-top: 1px solid var(--color-rule);
  }

  .principle:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .principle__heading {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 8vw + 0.5rem, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    margin-bottom: var(--space-xs);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .principle__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-md);
  }

  .principle__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-neutral);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* ── DATA OWNERSHIP ───────────────────────────────────── */

  .ownership {
    background: var(--color-paper-2);
    padding-block: clamp(var(--space-2xl), 12vw, var(--space-4xl));
    position: relative;
  }

  .ownership__accent-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 60%);
  }

  .ownership__headline {
    font-family: var(--font-display);
    font-size: var(--text-display-s);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--color-ink);
    margin-bottom: var(--space-xl);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .ownership__body {
    font-family: var(--font-body);
    font-size: clamp(var(--text-sm), 1.2vw + 0.4rem, var(--text-base));
    color: var(--color-neutral);
    line-height: 1.7;
    max-width: 52ch;
    margin-bottom: var(--space-lg);
  }

  .ownership__tagline {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  /* ── CTA SECTION ──────────────────────────────────────── */

  .cta-section {
    background: var(--color-paper);
    padding-block: clamp(var(--space-3xl), 14vw, var(--space-4xl));
    position: relative;
    overflow: hidden;
  }

  .cta-section__bloom {
    position: absolute;
    top: 50%;
    left: 30%;
    translate: -50% -50%;
    width: 700px;
    height: 700px;
    background: radial-gradient(
      circle,
      oklch(87% 0.295 142 / 0.05) 0%,
      transparent 65%
    );
    pointer-events: none;
  }

  .cta-section__prompt {
    font-family: var(--font-display);
    font-size: clamp(var(--text-lg), 2vw + 0.5rem, var(--text-xl));
    font-weight: 300;
    font-style: italic;
    color: var(--color-neutral);
    margin-bottom: var(--space-xl);
    letter-spacing: -0.01em;
  }

  .cta-section__btn {
    display: block;
    width: fit-content;
    background: var(--color-accent);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    padding: var(--space-lg) var(--space-3xl);
    border-radius: 2px;
    white-space: nowrap;
    margin-bottom: var(--space-lg);
    box-shadow: 0 0 40px oklch(87% 0.295 142 / 0.25);
    transition:
      box-shadow var(--dur-short) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-section__btn:hover {
      box-shadow: 0 0 60px oklch(87% 0.295 142 / 0.40);
      transform: translateY(-1px);
    }
  }

  .cta-section__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .cta-section__secondary {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.08em;
    width: fit-content;
    transition: color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-section__secondary:hover { color: var(--color-neutral); }
  }

  .cta-section__secondary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* ── FOOTER · Ft5 Statement ───────────────────────────── */

  .footer {
    background: var(--color-paper-2);
    border-top: 1px solid var(--color-rule);
    padding-block: var(--space-xl);
  }

  .footer__inner {
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: clamp(var(--space-lg), 6vw, var(--space-3xl));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .footer__statement {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-muted);
    max-width: 45ch;
  }

  .footer__meta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-shrink: 0;
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .footer__wordmark:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .footer__copy {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* ── REVEAL ANIMATION ─────────────────────────────────── */

  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity  var(--dur-long) var(--ease-out),
      transform var(--dur-long) var(--ease-out);
    transition-delay: calc(var(--i, 0) * 80ms);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      transform: none;
      transition: opacity 150ms linear;
      transition-delay: 0ms;
    }
  }

  /* ── RESPONSIVE ───────────────────────────────────────── */

  @media (max-width: 40rem) {
    .nav-pill {
      top: var(--space-md);
      padding: var(--space-2xs) var(--space-sm);
    }

    .hero__kanji {
      opacity: 0.025;
      right: -5vw;
    }

    .hero__declaration {
      transform: none;
    }

    .hero__ctas {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .footer__meta {
      order: -1;
    }
  }

  @media (min-width: 60rem) {
    .principle__desc {
      max-width: 60ch;
    }
  }
</style>
