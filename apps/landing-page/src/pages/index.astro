---
import Layout from '../layouts/Layout.astro';

const features = [
	{
		title: 'Track Everything',
		description: 'Todos, habits, time, budgets, knowledge — all in one place. Every aspect of your life, organized.',
		icon: '📋'
	},
	{
		title: 'Files, Not Silos',
		description: 'Your data lives in plain files on GitHub. No proprietary formats. No lock-in. Yours forever.',
		icon: '🔒'
	},
	{
		title: 'AI That Knows You',
		description: 'An AI companion that reads your files. It knows your goals, your habits, your context.',
		icon: '🧠'
	}
];
---

<Layout title="kaihuman — The ever-improving human.">
	<main class="relative min-h-screen cyber-grid-bg flex flex-col items-center justify-center p-6 overflow-hidden">
		<!-- Background Glow -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--los-accent)] rounded-full blur-[120px] opacity-10 pointer-events-none"></div>

		<!-- Hero Section -->
		<section class="max-w-5xl w-full mx-auto text-center space-y-8 relative z-10 pt-20 pb-32">
			<div class="flex justify-center mb-4 animate-fade-in-up">
				<img src="/favicon.svg" alt="kaihuman logo" class="w-20 h-20" />
			</div>
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[var(--los-accent-dim)] bg-[rgba(0,255,0,0.05)] text-[var(--los-accent)] text-sm font-mono mb-4 animate-fade-in-up">
				<span class="relative flex h-2 w-2">
				  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--los-accent)] opacity-75"></span>
				  <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--los-accent)]"></span>
				</span>
				改 &nbsp;kai · change for the better
			</div>

			<h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight text-white animate-fade-in-up delay-100">
				The ever-improving<br /><span class="text-[var(--los-accent)]">human.</span>
			</h1>

			<p class="text-xl md:text-2xl text-[var(--los-muted)] max-w-3xl mx-auto leading-relaxed animate-fade-in-up delay-200">
				<span class="text-[var(--los-fg)]">Kai</span> (改) means continuous improvement. <span class="text-[var(--los-fg)]">Human</span> is who you are.
				kaihuman is the operating system for becoming your best self — one deliberate day at a time.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-8 animate-fade-in-up delay-300">
				<a href="https://app.kaihuman.com" class="px-8 py-4 rounded-lg bg-[var(--los-accent)] text-black font-bold text-lg hover:bg-[#33ff33] transition-colors shadow-[0_0_20px_rgba(0,255,0,0.3)] hover:shadow-[0_0_30px_rgba(0,255,0,0.5)]">
					Start Improving
				</a>
				<a href="https://github.com/lifosy/monorepo" class="px-8 py-4 rounded-lg glass-panel hover:bg-[rgba(255,255,255,0.05)] text-[var(--los-fg)] font-medium text-lg transition-colors border-white/10">
					View Source
				</a>
			</div>
		</section>

		<!-- Product Screencast (auto-generated from the app's demo mode) -->
		<section class="w-full max-w-5xl mx-auto relative z-10 pb-24 animate-fade-in-up delay-400">
			<p class="text-center text-[var(--los-accent)] font-mono text-sm mb-6">// see it in action</p>
			<div class="rounded-2xl overflow-hidden glass-panel border border-[var(--los-accent-dim)] shadow-[0_0_60px_rgba(0,255,0,0.08)]">
				<div class="flex items-center gap-3 px-4 py-3 border-b border-white/10 bg-white/5">
					<span class="flex gap-1.5">
						<span class="w-3 h-3 rounded-full bg-white/15"></span>
						<span class="w-3 h-3 rounded-full bg-white/15"></span>
						<span class="w-3 h-3 rounded-full bg-white/15"></span>
					</span>
					<span class="flex-1 text-center text-xs font-mono text-[var(--los-muted)]">app.kaihuman.com &nbsp;·&nbsp; live demo</span>
					<span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[var(--los-accent)] border border-[var(--los-accent-dim)] px-1.5 py-0.5 rounded">DEMO</span>
				</div>
				<video
					class="block w-full h-auto"
					style="aspect-ratio: 1440 / 900"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					poster="/screencast-poster.jpg"
					aria-label="kaihuman product walkthrough: dashboards, kanban board, analytics, action log, wiki and the markdown editor"
				>
					<source src="/screencast.webm" type="video/webm" />
				</video>
			</div>
		</section>

		<!-- Kaizen Philosophy -->
		<section class="w-full max-w-5xl mx-auto rounded-2xl glass-panel p-12 md:p-20 text-center relative overflow-hidden border border-[var(--los-accent-dim)] animate-fade-in-up delay-400 mb-12">
			<div class="absolute inset-0 bg-[linear-gradient(45deg,rgba(0,255,0,0.05)_0%,transparent_100%)]"></div>
			<div class="relative z-10 space-y-6">
				<div class="text-7xl md:text-9xl font-bold text-[var(--los-accent)] opacity-20 select-none leading-none">改</div>
				<h2 class="text-3xl md:text-5xl font-bold text-white -mt-4">Small steps. Every day.</h2>
				<p class="text-xl text-[var(--los-muted)] max-w-2xl mx-auto">
					Kaizen — the Japanese philosophy of continuous, incremental improvement — is the most powerful force for human growth.
					Not perfection. Not disruption. Just <span class="text-[var(--los-fg)]">getting 1% better, every single day.</span>
				</p>
				<p class="text-lg text-[var(--los-muted)] max-w-xl mx-auto">
					kaihuman gives you the tools to make that real: track your habits, manage your goals, capture your knowledge, and reflect on your progress — all in one place.
				</p>
			</div>
		</section>

		<!-- Feature Grid -->
		<section class="max-w-7xl w-full mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10 pb-20">
			{features.map((feature, i) => (
				<div class="glass-tile p-8 rounded-xl space-y-4 animate-fade-in-up" style={`animation-delay: ${500 + i * 100}ms`}>
					<div class="text-4xl mb-4">{feature.icon}</div>
					<h3 class="text-2xl font-bold text-white">{feature.title}</h3>
					<p class="text-[var(--los-muted)] leading-relaxed">
						{feature.description}
					</p>
				</div>
			))}
		</section>

		<!-- Local First -->
		<section class="w-full max-w-5xl mx-auto rounded-2xl glass-panel p-12 md:p-20 text-center relative overflow-hidden border border-[var(--los-accent-dim)] animate-fade-in-up delay-700 mb-12">
			<div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(0,255,0,0.03)_0%,transparent_100%)]"></div>
			<div class="relative z-10 space-y-6">
				<h2 class="text-3xl md:text-5xl font-bold text-white">Your Data, Your Rules.</h2>
				<p class="text-xl text-[var(--los-muted)] max-w-2xl mx-auto">
					kaihuman is built <span class="text-[var(--los-accent)]">Local-First</span>. Your data lives in plain files on GitHub — readable, portable, and yours forever. We don't spy on you. Your growth is not a product to be sold.
				</p>
			</div>
		</section>

		<footer class="py-12 text-center text-[var(--los-muted)] relative z-10">
			<p>© {new Date().getFullYear()} kaihuman. Open Source & Independent.</p>
		</footer>
	</main>
</Layout>

<style>
	@keyframes fade-in-up {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		opacity: 0;
		animation: fade-in-up 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	.delay-100 { animation-delay: 100ms; }
	.delay-200 { animation-delay: 200ms; }
	.delay-300 { animation-delay: 300ms; }
	.delay-700 { animation-delay: 700ms; }
</style>
