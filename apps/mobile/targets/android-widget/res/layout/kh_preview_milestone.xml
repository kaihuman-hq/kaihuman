<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kh_preview_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kh_ms_title"
        android:textColor="@color/kh_accent"
        android:textSize="11sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kh_preview_ms_name"
        android:textColor="@color/kh_secondary"
        android:textSize="12sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/kh_preview_ms_days"
        android:textColor="@color/kh_on_surface"
        android:textSize="36sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/kh_ms_days_left"
        android:textColor="@color/kh_on_surface"
        android:textSize="12sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:background="@color/kh_track" />
</LinearLayout>
