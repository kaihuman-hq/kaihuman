{
  "name": "kaihuman",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "console:build": "turbo run build:prod --filter=@kaihuman/app-console",
    "landing:build": "turbo run build --filter=@kaihuman/landing-page",
    "landing-nextgen:build": "turbo run build --filter=@kaihuman/landing-page-nextgen",
    "dev:console": "turbo run dev watch --filter=@kaihuman/app-console --filter=@kaihuman/ui",
    "dev:landing": "turbo run dev --filter=@kaihuman/landing-page",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "check": "turbo run lint check-types",
    "fix": "turbo run fix",
    "verify": "pnpm run fix && pnpm run build && pnpm run lint && pnpm run format && pnpm run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "~19.3.0",
    "docspack": "1.5.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "turbo": "^2.10.12",
    "typescript": "5.9.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.4",
    "wrangler": "^4.148.0",
    "xcode": "4.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=18"
  }
}
