{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "console:build": "turbo run build:prod --filter=@lifosy/app-console",
    "landing:build": "turbo run build --filter=@lifosy/landing-page",
    "landing-nextgen:build": "turbo run build --filter=@lifosy/landing-page-nextgen",
    "dev:console": "turbo run dev watch --filter=@lifosy/app-console --filter=@lifosy/ui",
    "dev:landing": "turbo run dev --filter=@lifosy/landing-page",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "check": "turbo run lint check-types",
    "fix": "turbo run fix",
    "verify": "pnpm run fix && pnpm run build && pnpm run lint && pnpm run format && pnpm run check-types"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "turbo": "^2.7.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  }
}