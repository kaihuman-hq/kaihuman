{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "console:build": "turbo run build:prod --filter=@lifosy/app-console",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "check": "turbo run lint check-types",
    "validate": "pnpm run build && pnpm run lint && pnpm run format && pnpm run check-types"
  },
  "devDependencies": {
    "turbo": "^2.7.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18"
  }
}