{
  "name": "@kaihuman/docspack",
  "version": "0.1.0",
  "description": "kaihuman's documentation as a docspack package, for AI agents",
  "license": "MIT",
  "files": [
    ".llms",
    "llms.txt",
    "README.md"
  ],
  "keywords": [
    "docspack",
    "kaihuman",
    "documentation"
  ],
  "scripts": {
    "build": "docspack build",
    "lint": "docspack build && docspack doctor --strict",
    "test": "docspack build && docspack eval ./eval/queries.json --min-hit-rate 90",
    "prepublishOnly": "docspack build && docspack doctor --strict"
  },
  "docspack": {
    "from": "./docs",
    "cmdspec": "./cmdspec.yaml"
  }
}
