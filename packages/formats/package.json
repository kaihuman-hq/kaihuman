{
  "name": "@kaihuman/formats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./skills/*": "./skills/*",
    "./business": "./src/business/index.ts",
    "./dist/*": "./dist/*",
    "./business-templates/*": "./business-templates/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "fix": "biome check --write --unsafe .",
    "check-types": "tsc --noEmit",
    "build": "vite build --config vite.business-check.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
